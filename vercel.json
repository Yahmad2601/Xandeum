{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/nodes", "destination": "/api/nodes" },
    { "source": "/api/activities", "destination": "/api/activities" },
    { "source": "/api/crawler/status", "destination": "/api/crawler/status" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
